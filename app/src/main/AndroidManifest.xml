<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet für die Online-Analyse, die Online-Stimmen (Edge-TTS),
         die Themenbildersuche (Wikimedia/Openverse) und die Wikipedia-Links. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Benachrichtigungen für den Schnellzugriff auf dem Sperrbildschirm (ab Android 13) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Video-Export als Vordergrund-Dienst: läuft weiter, wenn die App
         geschlossen wird (Android 14+ verlangt die explizite Dienst-Art). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Paketsichtbarkeit: Apps sehen, die Teilen (WhatsApp, Instagram, Facebook,
         Telegram, Signal, YouTube, TikTok …) unterstützen – nötig ab Android 11. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".WerWieWasApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WerWieWas">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Einstieg über die Schnelleinstellungs-Kachel -->
            <intent-filter>
                <action android:name="de.derdl1983.weriewas.OPEN_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Einstieg über App-Symbol-Shortcut "Galerie" -->
            <intent-filter>
                <action android:name="de.derdl1983.weriewas.OPEN_GALLERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Long-Press-Shortcuts auf dem App-Symbol -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Erstellt das Erklärvideo im Hintergrund weiter, während die App
             geschlossen ist; Fortschritt und Ergebnis erscheinen als Benachrichtigung. -->
        <service
            android:name=".util.ExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.CameraTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Kachel darf auch auf dem Sperrbildschirm benutzt werden -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_LOCK_SCREEN"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
