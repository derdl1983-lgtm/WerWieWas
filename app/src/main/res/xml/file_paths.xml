<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Kamerafotos landen im Cache-Unterordner "camera" -->
    <cache-path name="camera" path="camera/" />
    <!-- Analysefotos im internen App-Speicher (Teilen über FileProvider) -->
    <files-path name="images" path="images/" />
    <!-- Exportierte Videos auf älteren Android-Versionen (unter Android 10) -->
    <external-files-path name="videos" path="Movies/videos/" />
    <files-path name="videos_intern" path="videos/" />
    <!-- Exportierte Audiodateien (Erklärung ohne Video) auf älteren Android-Versionen -->
    <external-files-path name="audio" path="Music/audio/" />
    <files-path name="audio_intern" path="audio/" />
</paths>
